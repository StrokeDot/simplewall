#include <windows.h>
#include "../src/app.h"

100 ICON "..\\src\\res\\100.ico"
101 ICON "..\\src\\res\\101.ico"

200 RCDATA "..\\bin\\64\\simplewall.exe"
201 RCDATA "..\\bin\\profile_internal.sp"

1 RT_MANIFEST "setup.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     APP_VERSION_RES
PRODUCTVERSION  APP_VERSION_RES
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName",      "StrokeDot / Henry++"
            VALUE "FileDescription",  "simplewall Setup Installer"
            VALUE "FileVersion",      APP_VERSION
            VALUE "InternalName",     "simplewall-setup"
            VALUE "OriginalFilename", "simplewall-setup.exe"
            VALUE "ProductName",      "simplewall"
            VALUE "ProductVersion",   APP_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1252
    END
END
